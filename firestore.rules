rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidYearMonth(ym) {
      return ym is string && ym.size() == 7 && ym.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function isValidTransaction(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.amount is int && data.amount > 0 && data.amount <= 999999999999 &&
             data.type in ['INCOME', 'EXPENSE'] &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
             data.date is int && data.date > 0 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             (!('note' in data) || (data.note is string && data.note.size() <= 250)) &&
             isValidYearMonth(data.yearMonth) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/transactions/{transactionId} {
      allow get: if isOwner(userId) && isValidId(transactionId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       isValidId(transactionId) &&
                       incoming().keys().hasAll([
                         'userId', 'amount', 'type', 'category', 'date',
                         'title', 'yearMonth', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'amount', 'type', 'category', 'date',
                         'title', 'note', 'yearMonth', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTransaction(incoming(), userId);
      allow update: if isOwner(userId) &&
                       isValidId(transactionId) &&
                       isValidTransaction(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'amount', 'type', 'category', 'date',
                         'title', 'note', 'yearMonth', 'updatedAt'
                       ]);
      allow delete: if isOwner(userId) && isValidId(transactionId);
    }
  }
}
